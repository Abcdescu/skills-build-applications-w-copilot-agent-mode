# OctoFit Tracker Frontend Environment Variables
# 
# To enable Codespaces support, copy this file to .env.local and set your Codespace name
# 
# Example:
#   VITE_CODESPACE_NAME=fuzzy-trout-pjgq9xx5r5wc9957

# Leave blank for localhost development (http://localhost:8000/api)
# Set to your Codespace name for Codespaces (https://YOUR_CODESPACE_NAME-8000.app.github.dev/api)
VITE_CODESPACE_NAME=
